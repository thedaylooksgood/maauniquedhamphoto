# Copy to .env.local (never commit real secrets)
SITE_URL=http://localhost:3000

# Admin password, plain (12+ chars, avoid the $ sign). Server-only, never shown.
# Local: put it here. Vercel: Settings → Environment Variables → ADMIN_PASSWORD.
ADMIN_PASSWORD=darjeeling123

# Signs admin cookies + encrypts Drive keys (min 32 random chars)
JWT_SECRET=change-me-to-32-plus-random-chars-please

# The temple's Google Drive (free). One-time: press "Connect with Google"
# in the dashboard, Allow, then paste the shown key here. Done forever.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
