# Copy to .env.local (never commit real secrets)
SITE_URL=http://localhost:3000

# Strong admin login — generate once, keep secret, single device at a time
# Create hash with: npx tsx scripts/make-hash.ts "Your-Strong-Password"
# (min 12 chars, mix case+number+symbol)
ADMIN_PASSWORD_HASH=

# Signs admin cookies + encrypts Drive tokens (min 32 random chars)
JWT_SECRET=change-me-to-32-plus-random-chars-please

# One-time Google login key (free). Google Cloud → OAuth client ID → Web application.
# Authorised redirect URI must be exactly:  {your SITE_URL}/api/drive/callback
# e.g. local:  http://localhost:3000/api/drive/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Drive connections are then added by clicking "Connect with Google" in the dashboard —
# no token scripts, no folder IDs to copy.
